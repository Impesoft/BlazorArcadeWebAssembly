@page "/Raycaster"
@namespace BlazorArcade.Pages
@using BlazorArcade.GameLogic

<video muted loop id="bg">
    <source src="./css/BGTunnel.mp4" type="video/mp4" />
</video>

<div class="top-controls">
    <button class="arcade-btn" @onclick="@(() => _nav.NavigateTo("/"))">Home</button>
    <button class="arcade-btn" @onclick="NewGame">New Game</button>
    <button class="arcade-btn" @onclick="TogglePause" disabled="@(_game.State != RaycasterState.Playing)">@(_game.IsPaused ? "Resume" : "Pause")</button>
</div>

<div class="rc-container">
    <div class="rc-hud">
        <div class="hud-item">
            <span class="hud-label">FLOOR</span>
            <span class="hud-value white">@(_game.LevelIndex + 1)</span>
        </div>
        <div class="hud-item">
            <span class="hud-label">SCORE</span>
            <span class="hud-value cyan">@_game.Score.ToString("D6")</span>
        </div>
        <div class="hud-item health">
            <span class="hud-label">HEALTH</span>
            <div class="health-bar"><div class="health-fill @HealthClass" style="width:@(_game.Health)%"></div></div>
            <span class="hud-value small @HealthClass">@_game.Health%</span>
        </div>
        <div class="hud-item">
            <span class="hud-label">AMMO</span>
            <span class="hud-value yellow">@_game.Ammo</span>
        </div>
        <div class="hud-item hide-narrow">
            <span class="hud-label">KILLS</span>
            <span class="hud-value red">@_game.Kills/@_game.TotalKills</span>
        </div>
        <div class="hud-item hide-narrow">
            <span class="hud-label">TREASURE</span>
            <span class="hud-value gold">@_game.Treasures/@_game.TotalTreasures</span>
        </div>
        <div class="hud-item hide-narrow">
            <span class="hud-label">HIGH</span>
            <span class="hud-value white">@_game.HighScore.ToString("D6")</span>
        </div>
    </div>

    <div class="rc-stage">
        <canvas id="rc-canvas" width="@RaycasterRenderer.Width" height="@RaycasterRenderer.Height"></canvas>

        @if (_game.Message is { } message && _game.State == RaycasterState.Playing)
        {
            <div class="rc-toast">@message</div>
        }

        @if (_game.State == RaycasterState.Title)
        {
            <div class="rc-overlay">
                <h1 class="rc-title">CRYPT CRAWLER <span>3D</span></h1>
                <p>Fight your way down through three floors of the crypt. Find the exit switch on each floor.</p>
                <p class="rc-sub">A software-rendered raycaster: every pixel is computed in C# running on WebAssembly.</p>
                <button class="modal-btn" @onclick="NewGame">START</button>
            </div>
        }
        else if (_game.State == RaycasterState.LevelComplete)
        {
            <div class="rc-overlay">
                <h2>FLOOR @(_game.LevelIndex + 1) CLEARED</h2>
                <p class="rc-floor-name">@_game.LevelName</p>
                <table class="rc-stats">
                    <tr><td>Kills</td><td>@_game.Kills / @_game.TotalKills</td></tr>
                    <tr><td>Treasure</td><td>@_game.Treasures / @_game.TotalTreasures</td></tr>
                    <tr><td>Time</td><td>@TimeSpan.FromSeconds(_game.LevelTime).ToString(@"m\:ss")</td></tr>
                    <tr><td>Bonus</td><td>+@_game.LevelBonus</td></tr>
                </table>
                <button class="modal-btn" @onclick="NextLevel">CONTINUE</button>
            </div>
        }
        else if (_game.State == RaycasterState.GameOver)
        {
            <div class="rc-overlay danger">
                <h2>YOU DIED</h2>
                <p>Final score: @_game.Score</p>
                <button class="modal-btn" @onclick="NewGame">TRY AGAIN</button>
                <Leaderboard Game="@ScoreGames.CryptCrawler" Score="@_game.Score" />
            </div>
        }
        else if (_game.State == RaycasterState.Victory)
        {
            <div class="rc-overlay">
                <h2>YOU ESCAPED THE CRYPT!</h2>
                <p>Final score: @_game.Score</p>
                <button class="modal-btn" @onclick="NewGame">PLAY AGAIN</button>
                <Leaderboard Game="@ScoreGames.CryptCrawler" Score="@_game.Score" />
            </div>
        }
        else if (_game.IsPaused)
        {
            <div class="rc-overlay">
                <h2>PAUSED</h2>
                <button class="modal-btn" @onclick="TogglePause">RESUME</button>
            </div>
        }
    </div>

    <div class="controls-panel">
        <div class="desktop-instructions">
            <span><strong>Move:</strong> W A S D</span>
            <span><strong>Turn:</strong> ← → or mouse (click the view)</span>
            <span><strong>Fire:</strong> Click / Ctrl / F</span>
            <span><strong>Open / exit:</strong> Space / E</span>
            <span><strong>Run:</strong> Shift</span>
            <span><strong>Map:</strong> M</span>
            <span><strong>Pause:</strong> P</span>
        </div>

        <div class="rc-touch">
            <div class="rc-dpad">
                <button class="dpad-btn up" data-input-bit="1">▲</button>
                <div class="dpad-middle">
                    <button class="dpad-btn" data-input-bit="4">◀</button>
                    <button class="dpad-btn" data-input-bit="8">▶</button>
                </div>
                <button class="dpad-btn down" data-input-bit="2">▼</button>
            </div>
            <div class="rc-actions">
                <button class="action-btn use" data-input-bit="128">USE</button>
                <button class="action-btn map" data-input-bit="512">MAP</button>
                <button class="action-btn fire" data-input-bit="64">FIRE</button>
            </div>
        </div>
        <p class="rc-touch-hint">Drag across the view to look around.</p>
    </div>
</div>
