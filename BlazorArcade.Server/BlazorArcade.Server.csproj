<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Online backend for the arcade: SignalR match hub (Chess, Connect 4) and the high-score API. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ChessDotNet" Version="1.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorArcade.Shared\BlazorArcade.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorArcade.Server.Tests" />
  </ItemGroup>

</Project>
